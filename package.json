{
  "name": "30-days-to-automation",
  "version": "1.0.0",
  "description": "A QA automation and CI portfolio demonstrating Playwright, JavaScript, API testing, cross-browser validation, and GitHub Actions.",
  "private": true,
  "type": "module",
  "author": "Testamplify Instructor",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/dajat/30DaysToAutomation.git"
  },
  "homepage": "https://github.com/dajat/30DaysToAutomation#readme",
  "bugs": {
    "url": "https://github.com/dajat/30DaysToAutomation/issues"
  },
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:debug": "npx playwright test --debug",
    "test:headed": "npx playwright test --headed",
    "test:learning": "playwright test --config=playwright.learning.config.js",
    "test:student": "npx playwright test tests/student.spec.js",
    "test:schedule": "npx playwright test tests/schedule.spec.js",
    "report": "npx playwright show-report",
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:learning": "playwright test --config=playwright.learning.config.js",
    "test:student": "playwright test tests/student.spec.js",
    "test:schedule": "playwright test tests/schedule.spec.js",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results"
  },
  "keywords": [
    "playwright",
    "javascript",
    "qa-automation",
    "software-testing",
    "end-to-end-testing",
    "api-testing",
    "cross-browser-testing",
    "page-object-model",
    "ci-cd",
    "github-actions",
    "allure"
  ],
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.35",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.6.0"
  }
}
